<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dynamic Island"
        Width="520" Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="Island"
                Width="208" Height="34"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#FC090A0D"
                BorderBrush="#24FFFFFF"
                BorderThickness="1"
                CornerRadius="17"
                ClipToBounds="True"
                SizeChanged="Island_SizeChanged"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_MouseLeftButtonUp"
                MouseRightButtonUp="Island_MouseRightButtonUp">
            <Border.RenderTransform>
                <TranslateTransform x:Name="IslandSlide" Y="0" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.32" Color="#000000" />
            </Border.Effect>

            <Grid x:Name="IslandContent" ClipToBounds="True">

                <!-- ═════════ компактная пилюля ═════════ -->
                <Grid x:Name="CompactLayer" Margin="13,0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="CompactScale" ScaleX="1" ScaleY="1" />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PillClock"
                               Text="--:--"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="#F2FFFFFF"
                               VerticalAlignment="Center" />

                    <StackPanel x:Name="PillEq"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Height="12"
                                Opacity="0">
                        <Rectangle Width="2.5" Height="12" RadiusX="1.25" Fill="#7FE0FF" Margin="1,0"
                                   RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Eq1" ScaleY="0.3" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="2.5" Height="12" RadiusX="1.25" Fill="#7FE0FF" Margin="1,0"
                                   RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Eq2" ScaleY="0.6" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="2.5" Height="12" RadiusX="1.25" Fill="#7FE0FF" Margin="1,0"
                                   RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Eq3" ScaleY="0.35" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="2.5" Height="12" RadiusX="1.25" Fill="#7FE0FF" Margin="1,0"
                                   RenderTransformOrigin="0.5,1">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="Eq4" ScaleY="0.5" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="PillWeatherIcon"
                                   FontFamily="Segoe UI Emoji"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="PillWeatherTemp"
                                   FontSize="11.5"
                                   Foreground="#B8FFFFFF"
                                   Margin="3,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ═════════ раскрытая карточка ═════════ -->
                <Grid x:Name="ExpandedLayer"
                      Margin="16,14"
                      Opacity="0"
                      Visibility="Hidden"
                      RenderTransformOrigin="0.5,0.18">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ExpandedScale" ScaleX="0.96" ScaleY="0.96" />
                            <TranslateTransform x:Name="ExpandedSlide" Y="10" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="3" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="38" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- музыка -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ArtBorder" Width="64" Height="64" CornerRadius="14" Background="#14FFFFFF">
                            <Grid>
                                <Image x:Name="ArtImage" Stretch="UniformToFill" />
                                <Grid x:Name="ArtPlaceholder">
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#25303A" Offset="0" />
                                            <GradientStop Color="#101317" Offset="1" />
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <TextBlock Text="♫"
                                               FontSize="24"
                                               Foreground="#59FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TrackSource"
                                       Text="МЕДИА"
                                       FontSize="8"
                                       Foreground="#66FFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TrackTitle"
                                       Grid.Row="1"
                                       Text="Ничего не играет"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,1,0,0" />
                            <TextBlock x:Name="TrackArtist"
                                       Grid.Row="2"
                                       Text="включите плеер"
                                       FontSize="10.5"
                                       Foreground="#94FFFFFF"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,1,0,0" />
                        </Grid>

                        <StackPanel x:Name="ExpandedEq"
                                    Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Height="14"
                                    Opacity="0">
                            <Rectangle Width="2.5" Height="14" RadiusX="1.25" Fill="#B87FE0FF" Margin="1,0"
                                       RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="EqX1" ScaleY="0.3" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="2.5" Height="14" RadiusX="1.25" Fill="#B87FE0FF" Margin="1,0"
                                       RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="EqX2" ScaleY="0.6" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="2.5" Height="14" RadiusX="1.25" Fill="#B87FE0FF" Margin="1,0"
                                       RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="EqX3" ScaleY="0.35" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="2.5" Height="14" RadiusX="1.25" Fill="#B87FE0FF" Margin="1,0"
                                       RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="EqX4" ScaleY="0.5" /></Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="2.5" Height="14" RadiusX="1.25" Fill="#B87FE0FF" Margin="1,0"
                                       RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform><ScaleTransform x:Name="EqX5" ScaleY="0.4" /></Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                    </Grid>

                    <!-- прогресс -->
                    <Border Grid.Row="2" CornerRadius="1.5" Background="#24FFFFFF">
                        <Border x:Name="ProgressFill"
                                Background="#F2FFFFFF"
                                CornerRadius="1.5"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>

                    <!-- управление -->
                    <Grid Grid.Row="4">
                        <TextBlock x:Name="PositionText"
                                   Text="0:00"
                                   FontSize="9.5"
                                   Foreground="#61FFFFFF"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Style="{StaticResource TransportButton}" Click="Previous_Click" ToolTip="Предыдущий трек">
                                <Path Data="M11,1 L4,6 L11,11 Z M1,1 H3.4 V11 H1 Z"
                                      Fill="#F2FFFFFF" Stretch="Uniform" Width="12" Height="12" />
                            </Button>
                            <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Click="PlayPause_Click"
                                    Margin="10,0" ToolTip="Играть / пауза">
                                <Path x:Name="PlayIcon"
                                      Data="M2,1 L10,6 L2,11 Z"
                                      Fill="#0B0C0F" Stretch="Uniform" Width="11" Height="12" />
                            </Button>
                            <Button Style="{StaticResource TransportButton}" Click="Next_Click" ToolTip="Следующий трек">
                                <Path Data="M1,1 L8,6 L1,11 Z M8.6,1 H11 V11 H8.6 Z"
                                      Fill="#F2FFFFFF" Stretch="Uniform" Width="12" Height="12" />
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="DurationText"
                                   Text="0:00"
                                   FontSize="9.5"
                                   Foreground="#61FFFFFF"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>

                    <!-- погода / время / батарея (включается по ПКМ) -->
                    <StackPanel x:Name="StatusBlock" Grid.Row="5" Visibility="Collapsed">
                        <Border Height="1" Background="#1AFFFFFF" Margin="0,11,0,0" />
                        <Grid Height="42" Margin="0,11,0,0">
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="0.9*" />
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="WeatherGroup" Grid.Column="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WeatherIcon"
                                       FontFamily="Segoe UI Emoji"
                                       FontSize="20"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="WeatherTemp"
                                               Text="--°"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFFFF" />
                                    <TextBlock x:Name="WeatherRange"
                                               FontSize="9"
                                               Foreground="#73FFFFFF"
                                               VerticalAlignment="Bottom"
                                               Margin="5,0,0,2" />
                                </StackPanel>
                                <TextBlock x:Name="WeatherCity"
                                           Text="погода"
                                           FontSize="9"
                                           Foreground="#8CFFFFFF"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="WeatherDivider" Grid.Column="1" Width="1" Background="#16FFFFFF" Margin="6,5,6,5" />

                        <StackPanel x:Name="ClockGroup" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="ClockTime"
                                       Text="--:--"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="ClockDate"
                                       FontSize="9"
                                       Foreground="#8CFFFFFF"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <Border x:Name="ClockDivider" Grid.Column="3" Width="1" Background="#16FFFFFF" Margin="6,5,6,5" />

                        <StackPanel x:Name="BatteryGroup" Grid.Column="4"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,2,0">
                            <Border x:Name="BatteryShell" Width="22" Height="11" CornerRadius="3"
                                    BorderBrush="#59FFFFFF" BorderThickness="1"
                                    Padding="1.5,1.5,1.5,1.5" VerticalAlignment="Center">
                                <Border x:Name="BatteryFill"
                                        Background="#E6FFFFFF"
                                        CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        Width="15" />
                            </Border>
                            <Path x:Name="PowerGlyph"
                                  Data="M12,1 V6 M8,3 V6 M16,3 V6 M5,6 H19 V10 A7,7 0 0 1 5,10 Z"
                                  Stroke="#8CFFFFFF"
                                  StrokeThickness="1.3"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Width="13" Height="13"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                            <TextBlock x:Name="BatteryText"
                                       Text="—"
                                       FontSize="10"
                                       Foreground="#99FFFFFF"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ═════════ приём файлов ═════════ -->
                <Grid x:Name="DropLayer" Margin="16,14" Opacity="0" Visibility="Hidden" RenderTransformOrigin="0.5,0.3">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="DropScale" ScaleX="0.97" ScaleY="0.97" />
                            <TranslateTransform x:Name="DropSlide" Y="8" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Rectangle RadiusX="14" RadiusY="14"
                                   Stroke="#8CE6FF"
                                   StrokeThickness="1.4"
                                   StrokeDashArray="3 3"
                                   Opacity="0.9" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="⇩"
                                       FontSize="22"
                                       Foreground="#8CE6FF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Отпустите файлы"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFFFF" />
                                <TextBlock Text="они останутся на полке"
                                           FontSize="9.5"
                                           Foreground="#80FFFFFF"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="DropShelf"
                          Grid.Row="1"
                          Height="70"
                          Margin="0,10,0,0"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="НА ПОЛКЕ"
                                           FontSize="8"
                                           Foreground="#8CE6FF"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="ShelfCount"
                                           FontSize="8"
                                           Foreground="#59FFFFFF"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="видно только при перетаскивании"
                                       FontSize="8"
                                       Foreground="#40FFFFFF"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ScrollViewer x:Name="ShelfScroll"
                                      Grid.Row="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PanningMode="HorizontalOnly"
                                      PreviewMouseWheel="ShelfScroll_PreviewMouseWheel">
                            <ItemsControl x:Name="ShelfList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="58" Height="50"
                                                CornerRadius="10"
                                                Background="#12FFFFFF"
                                                Margin="0,0,6,0"
                                                ToolTip="{Binding Name}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Image Source="{Binding Thumbnail}"
                                                       Height="26"
                                                       Stretch="Uniform"
                                                       Margin="4,6,4,0" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Name}"
                                                           FontSize="8"
                                                           Foreground="#B8FFFFFF"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Center"
                                                           Margin="4,2,4,4" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
